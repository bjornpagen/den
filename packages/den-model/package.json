{
	"name": "@den/model",
	"private": true,
	"description": "den's reference model and deterministic simulator: a den program as data (steps with declared reads, seats and ladders; scopes with exclusivity, windows and preconditions; roots and spawn edges), the ledger as immutable facts with every transition a pure function, a simulator of workers, transport, clock, census and relay driven by choice streams, den's laws as searches, edullm's eight workloads and AlphaTest's background work as programs. It imports nothing of den, so the real engine is held to it by differential tests.",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./datum": "./src/datum.ts",
		"./facts": "./src/facts.ts",
		"./identity": "./src/identity.ts",
		"./ledger": "./src/ledger.ts",
		"./machine": "./src/machine.ts",
		"./program": "./src/program.ts",
		"./properties": "./src/properties.ts",
		"./scenarios": "./src/scenarios.ts",
		"./search": "./src/search.ts",
		"./simulator": "./src/simulator.ts",
		"./workloads/alphatest": "./src/workloads/alphatest.ts",
		"./workloads/edullm": "./src/workloads/edullm.ts",
		"./workloads/enrollment": "./src/workloads/enrollment.ts",
		"./workloads/gap": "./src/workloads/gap.ts",
		"./workloads/gold": "./src/workloads/gold.ts",
		"./workloads/history": "./src/workloads/history.ts",
		"./workloads/metis": "./src/workloads/metis.ts",
		"./workloads/qti-sync": "./src/workloads/qti-sync.ts",
		"./workloads/reports": "./src/workloads/reports.ts",
		"./workloads/seed": "./src/workloads/seed.ts",
		"./workloads/synthetic": "./src/workloads/synthetic.ts",
		"./workloads/takedown": "./src/workloads/takedown.ts",
		"./workloads/timeback": "./src/workloads/timeback.ts",
		"./workloads/writeback": "./src/workloads/writeback.ts"
	},
	"scripts": {
		"typecheck": "toolchain-typecheck",
		"oxlint": "toolchain-oxlint",
		"load": "toolchain-test load",
		"test": "toolchain-test run"
	},
	"dependencies": {
		"@bjornpagen/testing": "workspace:*",
		"effect": "catalog:"
	}
}
