{
	"name": "@bjornpagen/den",
	"version": "0.0.0",
	"private": true,
	"description": "Durable execution on grizzle and PostgreSQL 19: a computation declared as a graph of steps, scopes and edges, lowered into the app's own grizzle schema, run one turn at a time.",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#integration/*": "./integration/*",
		"#test/*": "./test/*",
		"#*": "./src/*"
	},
	"exports": {
		"./algebra/flow": "./src/algebra/flow.ts",
		"./algebra/kinds": "./src/algebra/kinds.ts",
		"./lower/fragment": "./src/lower/fragment.ts",
		"./lower/generate": "./src/lower/generate.ts",
		"./lower/keys": "./src/lower/keys.ts",
		"./lower/print": "./src/lower/print.ts",
		"./lower/schema": "./src/lower/schema.ts",
		"./runtime/bind": "./src/runtime/bind.ts",
		"./runtime/census": "./src/runtime/census.ts",
		"./runtime/clock": "./src/runtime/clock.ts",
		"./runtime/drive": "./src/runtime/drive.ts",
		"./runtime/eligible": "./src/runtime/eligible.ts",
		"./runtime/identity": "./src/runtime/identity.ts",
		"./runtime/ledger": "./src/runtime/ledger.ts",
		"./runtime/relay": "./src/runtime/relay.ts",
		"./runtime/retire": "./src/runtime/retire.ts",
		"./runtime/seats": "./src/runtime/seats.ts",
		"./runtime/turn": "./src/runtime/turn.ts",
		"./transport": "./src/transport.ts"
	},
	"scripts": {
		"typecheck": "toolchain-typecheck",
		"typecheck:full": "toolchain-typecheck --incremental false",
		"oxlint": "toolchain-oxlint",
		"test": "vitest run --config vitest.config.ts",
		"test:network": "vitest run --config vitest.network.config.ts",
		"generate:slice": "node integration/slice/generate.ts && oxfmt integration/slice/generated"
	},
	"dependencies": {
		"@bjornpagen/grizzle": "workspace:*",
		"@bjornpagen/limit": "workspace:*",
		"@den/limits": "workspace:*",
		"@types/pg": "catalog:",
		"arkregex": "catalog:",
		"effect": "catalog:",
		"pg": "catalog:"
	},
	"devDependencies": {
		"@bjornpagen/devtools": "workspace:*",
		"@den/model": "workspace:*",
		"@bjornpagen/testing": "workspace:*",
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"vitest": "catalog:"
	}
}
