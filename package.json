{
	"name": "den-workspace",
	"private": true,
	"type": "module",
	"imports": {
		"#toolchain.config.ts": "./toolchain.config.ts"
	},
	"packageManager": "pnpm@12.16.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	},
	"scripts": {
		"prepare": "effect-tsgo patch",
		"check": "turbo run typecheck superlint oxlint format dead-code architecture dedupe --filter=./packages/* --filter=// --continue=dependencies-successful",
		"typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json",
		"superlint": "superlint",
		"oxlint": "oxlint oxlint.config.ts",
		"format": "oxfmt --check .",
		"format:write": "oxfmt .",
		"dead-code": "fallow dead-code",
		"architecture": "fallow architecture",
		"dedupe": "pnpm dedupe --check",
		"test": "turbo run test --filter=./packages/*",
		"test:network": "pnpm --filter @bjornpagen/den test:network",
		"fuzz": "node vendor/toolchain/packages/testing/scripts/fuzz.ts",
		"mutate": "node vendor/toolchain/packages/testing/scripts/mutate.ts",
		"pg": "scripts/pg.sh"
	},
	"devDependencies": {
		"@bjornpagen/devtools": "workspace:*",
		"@bjornpagen/testing": "workspace:*",
		"@effect/tsgo": "catalog:",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"fallow": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	}
}
