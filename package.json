{
	"name": "den-workspace",
	"private": true,
	"type": "module",
	"imports": {
		"#oxlint.config.ts": "./oxlint.config.ts",
		"#toolchain.config.ts": "./toolchain.config.ts"
	},
	"packageManager": "pnpm@12.18.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	},
	"scripts": {
		"prepare": "effect-tsgo patch",
		"check": "turbo run typecheck workspace-gate oxlint format dead-code architecture dedupe --filter=./packages/* --filter=// --continue=dependencies-successful",
		"check:full": "turbo run typecheck:full workspace-gate oxlint format dead-code architecture dedupe --filter=./packages/* --filter=// --continue=dependencies-successful --force",
		"types": "turbo run typecheck --filter=./packages/* --filter=//",
		"typecheck": "toolchain-typecheck",
		"typecheck:full": "toolchain-typecheck --incremental false",
		"workspace-gate": "workspace-gate",
		"oxlint": "toolchain-oxlint oxlint.config.ts oxlint.ast.config.ts",
		"format": "oxfmt --check .",
		"format:write": "oxfmt .",
		"dead-code": "fallow dead-code",
		"architecture": "fallow architecture",
		"dedupe": "pnpm dedupe --check",
		"test": "turbo run test --filter=./packages/*",
		"test:network": "pnpm --filter @bjornpagen/den test:network",
		"fuzz": "node vendor/toolchain/packages/testing/scripts/fuzz.ts",
		"pg": "scripts/pg.sh"
	},
	"devDependencies": {
		"@bjornpagen/devtools": "workspace:*",
		"@bjornpagen/testing": "workspace:*",
		"@effect/tsgo": "catalog:",
		"@types/node": "catalog:",
		"fallow": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
