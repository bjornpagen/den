{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"packages/devtools/src/oxlint/fixtures.config.ts",
		"packages/testing/src/vitest/coverage.ts",
		"packages/testing/src/vitest/mutated-setup.ts",
		"packages/testing/src/witness.fixtures.ts"
	],
	"ignorePatterns": ["packages/devtools/src/*/fixtures/**", "vendor/**"],
	// The superlint fixtures, which fallow does not read, are these two packages' only importers in the dev tools.
	"ignoreDependencies": ["@effect/vitest", "pg"],
	"boundaries": {
		"zones": [
			{
				"name": "testing",
				"patterns": ["packages/testing/**"]
			},
			{
				"name": "den",
				"patterns": ["packages/den/**"]
			},
			{
				"name": "den-model",
				"patterns": ["packages/den-model/**"]
			},
			{
				"name": "den-vercel",
				"patterns": ["packages/den-vercel/**"]
			},
			{
				"name": "edullm",
				"patterns": ["packages/edullm/**"]
			}
		],
		"rules": [
			{
				"from": "testing",
				"allow": []
			},
			{
				// den's own suites hold the engine to the reference model, which imports nothing of den.
				"from": "den",
				"allow": ["den-model"]
			},
			{
				"from": "den-model",
				"allow": []
			},
			{
				"from": "den-vercel",
				"allow": ["den"]
			},
			{
				"from": "edullm",
				"allow": ["den", "den-vercel"]
			}
		],
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": ["packages/devtools/**", "oxlint.config.ts"]
		}
	}
}
