{
	"$schema": "./node_modules/fallow/schema.json",
	// The commit gate's AST-only oxlint configuration, which the gate names by path; the vertical slice's grizzle config,
	// which the integration suites hand the grizzle CLI by path (integration/support/slice.ts); each package's runner
	// config, which toolchain-test loads by its path at the package root.
	"entry": [
		"oxlint.ast.config.ts",
		"packages/den/integration/slice/grizzle.config.ts",
		"packages/edullm/test.config.ts"
	],
	"ignorePatterns": ["vendor/**"],
	// The tsconfig's @effect/language-service plugin is no package: it is @effect/tsgo's, patched into TypeScript.
	"ignoreDependencies": ["@effect/language-service"],
	"boundaries": {
		"zones": [
			{
				"name": "den",
				"patterns": ["packages/den/**"]
			},
			{
				"name": "den-model",
				"patterns": ["packages/den-model/**"]
			},
			{
				"name": "den-vercel",
				"patterns": ["packages/den-vercel/**"]
			},
			{
				"name": "edullm",
				"patterns": ["packages/edullm/**"]
			}
		],
		"rules": [
			{
				// den's own suites hold the engine to the reference model, which imports nothing of den.
				"from": "den",
				"allow": ["den-model"]
			},
			{
				"from": "den-model",
				"allow": []
			},
			{
				"from": "den-vercel",
				"allow": ["den"]
			},
			{
				"from": "edullm",
				"allow": ["den", "den-vercel"]
			}
		],
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": ["oxlint.config.ts", "oxlint.ast.config.ts", "toolchain.config.ts"]
		}
	}
}
